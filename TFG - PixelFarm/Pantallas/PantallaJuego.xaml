<UserControl
     xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
     xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
     xmlns:converters="clr-namespace:TFG___PixelFarm.Converters"
     xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
     xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
     mc:Ignorable="d"
     x:Class="TFG___PixelFarm.Pantallas.PantallaJuego"
     d:DesignHeight="1598.18" d:DesignWidth="3234.59">
    <UserControl.Resources>
        <converters:TipoAColorConverter x:Key="tipoAColor"/>
        <converters:FaseAVisibilidadConverter x:Key="faseAVisibilidad"/>
        <converters:CartaSeleccionadaConverter x:Key="cartaSeleccionada"/>
        <converters:CeldaAColorConverter x:Key="celdaAColor"/>
        <converters:BoolAVisibilidadConverter x:Key="boolAVisibilidad"/>
        <converters:CartaACeldasConverter x:Key="cartaACeldas"/>
        <converters:CartaAColumnasConverter x:Key="cartaAColumnas"/>
        <converters:FaseATextoConverter x:Key="faseATexto"/>
        <converters:ActivaAColorConverter x:Key="activaAColor"/>
        <converters:TipoAImagenConverter x:Key="tipoAImagen"/>
        <converters:FormaACeldasConverter x:Key="formaACeldas"/>
        <converters:FormaAColumnasConverter x:Key="formaAColumnas"/>
        <converters:ReduccionAImagenConverter x:Key="reduccionAImagenConverter"/>
        <converters:EstacionAImagenConverter x:Key="estacionAImagen"/>
    </UserControl.Resources>
    <UserControl.Background>
        <ImageBrush ImageSource="/Assets/mesa.png" Stretch="Fill" TileMode="FlipX"/>
    </UserControl.Background>
    <Viewbox Stretch="Uniform">
        <Grid>
            <Grid.RowDefinitions>
                <!-- Fila 0: Recursos + Estación -->
                <RowDefinition Height="Auto"/>
                <!-- Fila 1: Tablero + Panel derecho -->
                <RowDefinition Height="*"/>
                <!-- Fila 2: Mano del jugador -->
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <!-- ===== FILA 0: Recursos y Estación ===== -->
            <StackPanel Grid.Row="0" Orientation="Horizontal"
                    HorizontalAlignment="Center" Margin="10,5">
                <Image Source="{Binding estacionActual, Converter={StaticResource estacionAImagen}}"
                   Height="74" Stretch="Uniform" Margin="0,0,15,0" Width="106"/>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Width="793">
                    <Image Source="/Assets/Lechuga.jpg" Width="103" Height="82"/>
                    <TextBlock Text="{Binding lechuga}" VerticalAlignment="Center" Margin="2,0,10,0" Foreground="White" FontSize="24"/>
                    <Image Source="/Assets/Tomate.jpg" Width="81" Height="82"/>
                    <TextBlock Text="{Binding tomate}" VerticalAlignment="Center" Margin="2,0,10,0" Foreground="White" FontSize="24"/>
                    <Image Source="/Assets/Maiz.jpg" Width="87" Height="80"/>
                    <TextBlock Text="{Binding maiz}" VerticalAlignment="Center" Margin="2,0,10,0" Foreground="White" FontSize="24"/>
                    <Image Source="/Assets/Moneda1.jpg" Width="81" Height="82"/>
                    <TextBlock Text="{Binding monedas}" VerticalAlignment="Center" Margin="2,0,10,0" Foreground="White" FontSize="24"/>
                    <Image Source="/Assets/Semillas.jpg" Width="89" Height="79"/>
                    <TextBlock Text="{Binding semillasActuales, Mode=OneWay}" VerticalAlignment="Center" Margin="2,0,10,0" Foreground="White" FontSize="24"/>
                    <TextBlock Text="Puntos:" VerticalAlignment="Center" Margin="0,0,2,0" Foreground="White" Width="97" FontSize="24"/>
                    <TextBlock Text="{Binding puntosActuales, Mode=OneWay}" VerticalAlignment="Center" Foreground="White" FontSize="24" />
                </StackPanel>
            </StackPanel>
            <!-- ===== FILA 1: Tablero  + Panel derecho (independiente) ===== -->
            <Grid Grid.Row="1">
                <!-- Tablero: centrado respecto a TODA la fila -->
                <Grid HorizontalAlignment="Center" VerticalAlignment="Center" Margin="30">
                    <Grid.Background>
                        <ImageBrush ImageSource="/Assets/campo.png" Stretch="UniformToFill"/>
                    </Grid.Background>
                    <ItemsControl x:Name="gridGranja"
                        ItemsSource="{Binding celdas}"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center" Height="590" Width="924">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Rows="{Binding granjaFilas}"
                                     Columns="{Binding granjaColumnas}"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Click="btnCelda_Click"
                                        MouseEnter="btnCelda_Enter"
                                        MouseLeave="btnCelda_Leave"
                                        Cursor="Hand">
                                    <Button.Background>
                                        <MultiBinding Converter="{StaticResource celdaAColor}">
                                            <Binding Path="tipo"/>
                                            <Binding Path="esPreview"/>
                                            <Binding Path="tipoPreview"/>
                                        </MultiBinding>
                                    </Button.Background>
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{TemplateBinding Background}"
                                                    BorderBrush="Gray" BorderThickness="1">
                                                <ContentPresenter HorizontalAlignment="Center"
                                                                  VerticalAlignment="Center"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Button.Template>
                                    <Image Source="{Binding tipo, Converter={StaticResource tipoAImagen}}"
                                           Width="120" Height="120"
                                           IsHitTestVisible="False">
                                        <Image.Style>
                                            <Style TargetType="Image">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding esPreview}" Value="True">
                                                        <Setter Property="Opacity" Value="0.35"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Image.Style>
                                    </Image>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Grid>
                <!-- Panel derecho:  -->
                <ScrollViewer HorizontalAlignment="Left" VerticalScrollBarVisibility="Auto" Width="320" Margin="2096,-45,0,45">
                    <StackPanel Margin="10">
                        <!-- Fase -->
                        <Border Background="#4A2C00" CornerRadius="10" Padding="8,4" Margin="0,5,0,5" Height="48" Width="306">
                            <TextBlock Text="{Binding faseActual, Converter={StaticResource faseATexto}}" Foreground="White"
           FontWeight="Bold" HorizontalAlignment="Center" FontSize="24"/>
                        </Border>
                        <!-- Mercado -->
                        <ItemsControl ItemsSource="{Binding cartasMercado}"
                                  Visibility="{Binding faseActual, ConverterParameter=Mercado, Converter={StaticResource faseAVisibilidad}}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Width="80" Height="110" Margin="3"
                                        Click="btnComprarMercado_Click"
                                        Cursor="Hand" Padding="4">
                                        <Button.Template>
                                            <ControlTemplate TargetType="{x:Type Button}">
                                                <Border BorderBrush="Brown" BorderThickness="2"
                                                    Background="BurlyWood" CornerRadius="10">
                                                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                                        <ItemsControl>
                                                            <ItemsControl.ItemsSource>
                                                                <MultiBinding Converter="{StaticResource cartaACeldas}">
                                                                    <Binding/>
                                                                    <Binding Source="{x:Null}"/>
                                                                    <Binding Source="{x:Null}"/>
                                                                </MultiBinding>
                                                            </ItemsControl.ItemsSource>
                                                            <ItemsControl.ItemsPanel>
                                                                <ItemsPanelTemplate>
                                                                    <UniformGrid>
                                                                        <UniformGrid.Columns>
                                                                            <MultiBinding Converter="{StaticResource cartaAColumnas}">
                                                                                <Binding/>
                                                                                <Binding Source="{x:Null}"/>
                                                                                <Binding Source="{x:Null}"/>
                                                                            </MultiBinding>
                                                                        </UniformGrid.Columns>
                                                                    </UniformGrid>
                                                                </ItemsPanelTemplate>
                                                            </ItemsControl.ItemsPanel>
                                                            <ItemsControl.ItemTemplate>
                                                                <DataTemplate>
                                                                    <Border Width="28" Height="28"
                                                                        BorderBrush="Gray" BorderThickness="0.5">
                                                                        <Image Source="{Binding tipo, Converter={StaticResource tipoAImagen}}"
                                                                           Stretch="UniformToFill"/>
                                                                    </Border>
                                                                </DataTemplate>
                                                            </ItemsControl.ItemTemplate>
                                                        </ItemsControl>
                                                        <!-- Coste: se paga con verduras de un solo tipo -->
                                                        <TextBlock HorizontalAlignment="Center" Margin="0,4,0,0" FontSize="10">
                                                            <Run Text="{Binding CosteActual, Mode=OneWay}" FontWeight="Bold"/>
                                                            <Run Text=" verduras"/>     
                                                        </TextBlock>
                                                        <Image HorizontalAlignment="Center" Width="20" Height="20" Margin="0,2,0,0"
                                                           Source="{Binding ReduccionCoste, Converter={StaticResource reduccionAImagenConverter}}"/>
                                                    </StackPanel>
                                                </Border>
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        
                        <TextBlock Foreground="White" FontSize="24" TextWrapping="Wrap" Margin="0,5,0,0"
           Visibility="{Binding faseActual, ConverterParameter=Mercado, Converter={StaticResource faseAVisibilidad}}">
    <Run Text="Compras restantes: " FontWeight="Bold"/>
    <Run Text="{Binding textoCompras, Mode=OneWay}"/>
                        </TextBlock>
                        <!-- Comercio -->
                        <TextBlock Text="Comercio" FontSize="24" FontWeight="Bold" Margin="0,10,0,0" Foreground="White"/>
                        <TextBlock Text="{Binding descripcionComercio}" FontSize="24" Margin="0,5" TextWrapping="Wrap" Foreground="White"/>
                        <StackPanel Orientation="Horizontal" Margin="0,3,0,3">
                            <TextBlock Text="Nivel: " VerticalAlignment="Center" Foreground="White" FontWeight="Bold"/>
                            <TextBlock Text="{Binding nivelComercio}" FontWeight="Bold" VerticalAlignment="Center" Foreground="White"/>
                        </StackPanel>
                        <Button Content="Usar comercio" Click="btnUsarComercio_Click"
                            IsEnabled="{Binding puedeUsarComercio}"
                            Visibility="{Binding faseActual, ConverterParameter=Mercado, Converter={StaticResource faseAVisibilidad}}" Height="66" Width="187" FontSize="24" Cursor="Arrow"/>
                        <!-- Objetivos -->
                        <TextBlock Text="Objetivos" FontSize="24" FontWeight="Bold" Margin="0,10,0,0" Foreground="White"
                               Visibility="{Binding faseActual, ConverterParameter=Mercado, Converter={StaticResource faseAVisibilidad}}"/>
                        <ItemsControl ItemsSource="{Binding cartasObjetivo}"
                                  Visibility="{Binding faseActual, ConverterParameter=Mercado, Converter={StaticResource faseAVisibilidad}}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Width="140" Height="210" Margin="3"
                                        Click="btnComprarObjetivo_Click"
                                        Cursor="Hand" Padding="4">
                                        <Button.Template>
                                            <ControlTemplate TargetType="{x:Type Button}">
                                                <Border BorderBrush="DarkGreen" BorderThickness="2"
                                                    Background="LightGreen" CornerRadius="10">
                                                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                                            <TextBlock Text="Da " FontSize="10"/>
                                                            <TextBlock Text="{Binding Puntos}" FontSize="10"
                                                                   FontWeight="Bold" VerticalAlignment="Center"/>
                                                            <TextBlock Text=" Puntos" FontSize="10"/>
                                                        </StackPanel>
                                                        <ItemsControl ItemsSource="{Binding Converter={StaticResource formaACeldas}}"
                                                                  Margin="0,2,0,2">
                                                            <ItemsControl.ItemsPanel>
                                                                <ItemsPanelTemplate>
                                                                    <UniformGrid Columns="{Binding Converter={StaticResource formaAColumnas}}"/>
                                                                </ItemsPanelTemplate>
                                                            </ItemsControl.ItemsPanel>
                                                            <ItemsControl.ItemTemplate>
                                                                <DataTemplate>
                                                                    <Border Width="15" Height="15" Margin="1"
                                                                        BorderBrush="DarkGreen" BorderThickness="0.5">
                                                                        <Border.Background>
                                                                            <SolidColorBrush Color="{Binding activa, Converter={StaticResource activaAColor}}"/>
                                                                        </Border.Background>
                                                                    </Border>
                                                                </DataTemplate>
                                                            </ItemsControl.ItemTemplate>
                                                        </ItemsControl>
                                                        <!-- Coste del pedido (solo visible si es tipo Pedido) -->
                                                        <StackPanel Visibility="{Binding esObjetivoPedido, Converter={StaticResource boolAVisibilidad}}"
                                                                    Margin="0,4,0,0" HorizontalAlignment="Center">
                                                            <TextBlock Text="Coste:" FontSize="9" FontWeight="Bold" HorizontalAlignment="Center"/>
                                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                                                <!-- Lechuga -->
                                                                <StackPanel Orientation="Horizontal" Margin="2,0">
                                                                    <Image Source="/Assets/Lechuga.jpg" Width="14" Height="14"/>
                                                                    <TextBlock Text="{Binding CosteLechuga}" FontSize="9" VerticalAlignment="Center" Margin="1,0,0,0"/>
                                                                </StackPanel>
                                                                <!-- Tomate -->
                                                                <StackPanel Orientation="Horizontal" Margin="2,0">
                                                                    <Image Source="/Assets/Tomate.jpg" Width="14" Height="14"/>
                                                                    <TextBlock Text="{Binding CosteTomate}" FontSize="9" VerticalAlignment="Center" Margin="1,0,0,0"/>
                                                                </StackPanel>
                                                                <!-- Maíz -->
                                                                <StackPanel Orientation="Horizontal" Margin="2,0">
                                                                    <Image Source="/Assets/Maiz.jpg" Width="14" Height="14"/>
                                                                    <TextBlock Text="{Binding CosteMaiz}" FontSize="9" VerticalAlignment="Center" Margin="1,0,0,0"/>
                                                                </StackPanel>
                                                            </StackPanel>
                                                        </StackPanel>
                                                        <ItemsControl>
                                                            <ItemsControl.ItemsSource>
                                                                <MultiBinding Converter="{StaticResource cartaACeldas}">
                                                                    <Binding/>
                                                                    <Binding Source="{x:Null}"/>
                                                                    <Binding Source="{x:Null}"/>
                                                                </MultiBinding>
                                                            </ItemsControl.ItemsSource>
                                                            <ItemsControl.ItemsPanel>
                                                                <ItemsPanelTemplate>
                                                                    <UniformGrid>
                                                                        <UniformGrid.Columns>
                                                                            <MultiBinding Converter="{StaticResource cartaAColumnas}">
                                                                                <Binding/>
                                                                                <Binding Source="{x:Null}"/>
                                                                                <Binding Source="{x:Null}"/>
                                                                            </MultiBinding>
                                                                        </UniformGrid.Columns>
                                                                    </UniformGrid>
                                                                </ItemsPanelTemplate>
                                                            </ItemsControl.ItemsPanel>
                                                            <ItemsControl.ItemTemplate>
                                                                <DataTemplate>
                                                                    <Border BorderBrush="Gray" BorderThickness="0.5"
                                                                        Background="{Binding tipo, Converter={StaticResource tipoAColor}}">
                                                                        <Image Source="{Binding tipo, Converter={StaticResource tipoAImagen}}"
                                                                           Stretch="UniformToFill"
                                                                           IsHitTestVisible="False"/>
                                                                    </Border>
                                                                </DataTemplate>
                                                            </ItemsControl.ItemTemplate>
                                                        </ItemsControl>
                                                    </StackPanel>
                                                </Border>
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <!-- Botones de acción -->
                        <StackPanel>
                            <Button Content="Rotar carta" Click="btnRotar_Click" Margin="0,5" Height="137" Width="241" FontSize="24"/>
                            <Button Content="Usar Pala" Click="btnUsarPala_Click" Margin="0,5"
                                Visibility="{Binding hayPalas, Converter={StaticResource boolAVisibilidad}}" Height="137" Width="241" FontSize="24"/>
                            <Button Content="Terminar colocación" Click="btnTerminarColocacion_Click"
                                Visibility="{Binding faseActual, ConverterParameter=JugarCartas, Converter={StaticResource faseAVisibilidad}}" Height="137" Width="241" FontSize="24"/>
                            <Button Content="Terminar compra" Click="btnTerminarCompra_Click"
                                Visibility="{Binding faseActual, ConverterParameter=Mercado, Converter={StaticResource faseAVisibilidad}}" Height="137" Width="241" FontSize="24"/>
                            <Button Content="Terminar cosecha" Click="btnTerminarCosecha_Click"
                                Visibility="{Binding faseActual, ConverterParameter=CosechaVerduras, Converter={StaticResource faseAVisibilidad}}" Height="137" Width="241" FontSize="24"/>
                            <Button Content="Instrucciones" Click="btnInstrucciones_Click" Height="137" Width="241" FontSize="24"/>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
            <!-- ===== FILA 2: Mano del jugador ===== -->
            <ItemsControl Grid.Row="2" ItemsSource="{Binding cartasEnMano}"
                      HorizontalAlignment="Center">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Margin="9" BorderThickness="3" CornerRadius="10"
                            Background="BurlyWood" Cursor="Hand"
                            MouseLeftButtonDown="btnCarta_Click"
                            Padding="4">
                            <Border.BorderBrush>
                                <MultiBinding Converter="{StaticResource cartaSeleccionada}">
                                    <Binding/>
                                    <Binding Path="DataContext.cartaSeleccionada"
                                         RelativeSource="{RelativeSource AncestorType={x:Type UserControl}}"/>
                                </MultiBinding>
                            </Border.BorderBrush>
                            <ItemsControl>
                                <ItemsControl.ItemsSource>
                                    <MultiBinding Converter="{StaticResource cartaACeldas}">
                                        <Binding/>
                                        <Binding Path="DataContext.cartaSeleccionada"
                                             RelativeSource="{RelativeSource AncestorType={x:Type UserControl}}"/>
                                        <Binding Path="DataContext.rotacionActual"
                                             RelativeSource="{RelativeSource AncestorType={x:Type UserControl}}"/>
                                    </MultiBinding>
                                </ItemsControl.ItemsSource>
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <UniformGrid>
                                            <UniformGrid.Columns>
                                                <MultiBinding Converter="{StaticResource cartaAColumnas}">
                                                    <Binding/>
                                                    <Binding Path="DataContext.cartaSeleccionada"
                                                         RelativeSource="{RelativeSource AncestorType={x:Type UserControl}}"/>
                                                    <Binding Path="DataContext.rotacionActual"
                                                         RelativeSource="{RelativeSource AncestorType={x:Type UserControl}}"/>
                                                </MultiBinding>
                                            </UniformGrid.Columns>
                                        </UniformGrid>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border BorderBrush="Gray" BorderThickness="0" Margin="2" Padding="0"
                                            Background="{Binding tipo, Converter={StaticResource tipoAColor}}">
                                            <Image Source="{Binding tipo, Converter={StaticResource tipoAImagen}}"
                                               Stretch="UniformToFill"
                                               IsHitTestVisible="False"/>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Grid>
    </Viewbox>
</UserControl>
