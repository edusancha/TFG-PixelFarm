<Window x:Class="TFG___PixelFarm.Pantallas.DialogoElegirCarta"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Elegir carta" Height="300" Width="400"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize">
    <StackPanel Margin="20">
        <TextBlock x:Name="txtTitulo" FontSize="14" Margin="0,0,0,15"/>
        <ListBox x:Name="listaCartas" Height="150"
                 DisplayMemberPath="nombre"/>
        <StackPanel Orientation="Horizontal" 
                    HorizontalAlignment="Center" Margin="0,10,0,0">
            <Button Content="Confirmar" Width="80" Margin="5"
                    Click="btnConfirmar_Click"/>
            <Button Content="Cancelar" Width="80" Margin="5"
                    Click="btnCancelar_Click"/>
        </StackPanel>
    </StackPanel>
</Window>