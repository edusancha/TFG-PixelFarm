<Window x:Class="TFG___PixelFarm.Pantallas.DialogoCosecha"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Guardar verduras" Height="280" Width="571"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize">
    <StackPanel Margin="20">
        <TextBlock x:Name="txtCampos" FontSize="14" Margin="0,0,0,15"/>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition/>
                <RowDefinition/>
            </Grid.RowDefinitions>

            <TextBlock Text="Lechuga" Grid.Column="0" Grid.Row="0"
                       HorizontalAlignment="Center"/>
            <TextBlock Text="Tomate" Grid.Column="1" Grid.Row="0"
                       HorizontalAlignment="Center"/>
            <TextBlock Text="Maíz" Grid.Column="2" Grid.Row="0"
                       HorizontalAlignment="Center"/>

            <StackPanel Grid.Column="0" Grid.Row="1" 
                        Orientation="Horizontal"
                        HorizontalAlignment="Center">
                <Button Content="-" Width="25" Click="btnLechugaMenos_Click"/>
                <TextBlock x:Name="txtLechuga" Text="0" Width="30"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"/>
                <Button Content="+" Width="25" Click="btnLechugaMas_Click"/>
            </StackPanel>

            <StackPanel Grid.Column="1" Grid.Row="1"
                        Orientation="Horizontal"
                        HorizontalAlignment="Center">
                <Button Content="-" Width="25" Click="btnTomateMenos_Click"/>
                <TextBlock x:Name="txtTomate" Text="0" Width="30"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"/>
                <Button Content="+" Width="25" Click="btnTomateMas_Click"/>
            </StackPanel>

            <StackPanel Grid.Column="2" Grid.Row="1"
                        Orientation="Horizontal"
                        HorizontalAlignment="Center">
                <Button Content="-" Width="25" Click="btnMaizMenos_Click"/>
                <TextBlock x:Name="txtMaiz" Text="0" Width="30"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"/>
                <Button Content="+" Width="25" Click="btnMaizMas_Click"/>
            </StackPanel>
        </Grid>

        <StackPanel Orientation="Horizontal"
                    HorizontalAlignment="Center" Margin="0,15,0,0">
            <Button Content="Confirmar" Width="80" Margin="5"
                    Click="btnConfirmar_Click"/>
            <Button Content="Cancelar" Width="80" Margin="5"
                    Click="btnCancelar_Click"/>
        </StackPanel>
    </StackPanel>
</Window>