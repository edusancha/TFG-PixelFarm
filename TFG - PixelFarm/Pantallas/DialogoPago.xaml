<Window x:Class="TFG___PixelFarm.Pantallas.DialogoPago"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Elegir pago" Height="200" Width="467"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize">
    <StackPanel Margin="20">
        <TextBlock x:Name="txtCoste" FontSize="14" Margin="0,0,0,15"/>
        <TextBlock
                   FontSize="12" Margin="0,0,0,10"><Run Language="es-es" Text="                                      "/><Run Text="¿Con qué verdura quieres pagar?"/></TextBlock>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
            <Button Content="Lechuga" Width="80" Margin="5"
                    Click="btnLechuga_Click"/>
            <Button Content="Tomate" Width="80" Margin="5"
                    Click="btnTomate_Click"/>
            <Button Content="Maíz" Width="80" Margin="5"
                    Click="btnMaiz_Click"/>
        </StackPanel>
        <CheckBox x:Name="chkUsarMoneda" Content="Usar 1 moneda (-1 al coste)" Width="166"
          />
        <Button Content="Cancelar" Margin="0,10,0,0"
                Click="btnCancelar_Click"/>
    </StackPanel>
</Window>